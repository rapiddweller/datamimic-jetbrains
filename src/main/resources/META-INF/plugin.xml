<!-- https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Marketplace identity: never change after the first release. -->
    <id>com.rapiddweller.datamimic</id>
    <name>DATAMIMIC</name>
    <vendor url="https://datamimic.io">rapiddweller</vendor>

    <description><![CDATA[
        <p>Work on DATAMIMIC projects in your JetBrains IDE, connected to your DATAMIMIC Enterprise Platform.</p>
        <p><b>Requires a DATAMIMIC Enterprise Platform</b> and an account on it. The plugin does not work without one;
        support for the open-source DATAMIMIC CE is planned.</p>
        <ul>
          <li>Sign in with your platform account and browse your projects in the DATAMIMIC tool window.</li>
          <li>Open a platform project as a normal local project. Files sync both ways, protected by the platform's
              edit locks; changes on both sides show a conflict banner.</li>
          <li>Completion and checks from the platform's language server, with a status bar switch to turn it on or
              off for the project.</li>
          <li>Generate data on the platform and preview the results.</li>
          <li>Connect IDE agents to the project's MCP server.</li>
        </ul>
        ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- The platform's language server needs the IDE's LSP API; without it the rest of the plugin still works. -->
    <depends optional="true" config-file="datamimic-lsp.xml">com.intellij.modules.lsp</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- id must match TOOL_WINDOW_ID -->
        <toolWindow id="DATAMIMIC" anchor="left" icon="/icons/datamimic.svg"
                    factoryClass="com.rapiddweller.datamimic.ide.ProjectsToolWindowFactory"/>
        <welcomeTabFactory implementation="com.rapiddweller.datamimic.ide.DatamimicWelcomeTabFactory"/>
        <writingAccessProvider implementation="com.rapiddweller.datamimic.ide.editing.PlatformWritingAccess"/>
        <editorNotificationProvider implementation="com.rapiddweller.datamimic.ide.editing.PlatformFileBanner"/>
        <directoryIndexExcludePolicy implementation="com.rapiddweller.datamimic.ide.editing.ProjectFolderExcludePolicy"/>
        <notificationGroup id="DATAMIMIC" displayType="BALLOON"/>
        <postStartupActivity implementation="com.rapiddweller.datamimic.ide.ActiveProjectStartup"/>
    </extensions>

    <actions>
        <action id="Datamimic.OpenPlatformProject" class="com.rapiddweller.datamimic.ide.OpenPlatformProjectAction"
                text="Open DATAMIMIC Project…" icon="/icons/datamimic.svg"
                description="Sign in to your DATAMIMIC Enterprise Platform and open one of its projects in a new window">
            <add-to-group group-id="WelcomeScreen.QuickStart" anchor="last"/>
            <add-to-group group-id="FileOpenGroup" anchor="last"/>
        </action>
    </actions>

    <applicationListeners>
        <listener class="com.rapiddweller.datamimic.ide.ActiveProjectCloser"
                  topic="com.intellij.openapi.project.ProjectCloseListener"/>
        <listener class="com.rapiddweller.datamimic.ide.editing.FolderChangeListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </applicationListeners>

    <projectListeners>
        <listener class="com.rapiddweller.datamimic.ide.editing.PlatformEditorListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>
</idea-plugin>
